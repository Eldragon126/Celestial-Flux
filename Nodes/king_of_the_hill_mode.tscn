[node name="KingOfTheHillMode" type="Node2D" groups=["campaign_mode", "king_of_the_hill_mode"]]
script = ExtResource("1_campaign")
retry_scene_path = "res://Nodes/king_of_the_hill_mode.tscn"
campaign_name = "King Of The Hill"
final_wave = 99
start_credits = 60
king_of_hill_mode = true
hill_capture_goal = 120.0

[node name="HomePlanet" parent="." instance=ExtResource("3_mother")]
