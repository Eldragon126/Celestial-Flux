{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoranomaly.game/modding/manifest.schema.json",
  "title": "Vector Anomaly Mod Manifest",
  "description": "Safe, data-driven content contract for Vector Anomaly schema 4.",
  "type": "object",
  "required": ["id", "version"],
  "properties": {
    "id": {"$ref": "#/$defs/safeId"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "author": {"type": "string", "maxLength": 128},
    "version": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1, "maxLength": 64}]},
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 4, "default": 4},
    "description": {"type": "string", "maxLength": 2048},
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "conflicts": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/safeId"}, {"$ref": "#/$defs/conflict"}]}},
    "load_after": {"type": "array", "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true},
    "load_before": {"type": "array", "items": {"$ref": "#/$defs/safeId"}, "uniqueItems": true},
    "options": {"type": "array", "items": {"$ref": "#/$defs/modOption"}},
    "content": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[a-z0-9_-]+$", "minLength": 1, "maxLength": 96},
    "networkCategory": {"enum": ["local_visual", "exported_state", "reliable_event", "deterministic_seed"]},
    "dependency": {
      "oneOf": [
        {"$ref": "#/$defs/safeId"},
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"$ref": "#/$defs/safeId"},
            "required": {"type": "boolean", "default": true},
            "min_version": {"type": "string", "minLength": 1, "maxLength": 64},
            "max_version": {"type": "string", "minLength": 1, "maxLength": 64}
          },
          "additionalProperties": false
        }
      ]
    },
    "conflict": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "reason": {"type": "string", "maxLength": 256}
      },
      "additionalProperties": false
    },
    "modOption": {
      "type": "object",
      "required": ["id", "type", "default"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "display_name": {"type": "string", "maxLength": 128},
        "description": {"type": "string", "maxLength": 512},
        "type": {"enum": ["bool", "int", "float", "string", "choice", "color"]},
        "default": {},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "choices": {"type": "array", "minItems": 1, "uniqueItems": true},
        "network_category": {"$ref": "#/$defs/networkCategory"}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "manifest_id": {"$ref": "#/$defs/safeId"},
        "mod_id": {"$ref": "#/$defs/safeId"},
        "option_id": {"$ref": "#/$defs/safeId"},
        "operator": {"enum": ["equals", "not_equals", "greater_than", "greater_or_equal", "less_than", "less_or_equal"]},
        "value": {}
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["action"],
      "properties": {"action": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "display_name": {"type": "string", "maxLength": 128},
        "network_category": {"$ref": "#/$defs/networkCategory"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "hooks": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "cooldown": {"type": "number", "minimum": 0},
        "max_triggers": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
